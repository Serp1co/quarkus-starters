<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>it.bancaditalia.quarkus</groupId>
    <artifactId>quarkus-starters</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>poc-a-jakarta-classic</artifactId>
  <name>POC A: Jakarta classic</name>
  <description>
    Migration class A (design note 4.1): JAX-RS, CDI, JPA, JTA and Bean Validation moved from JBoss EAP to
    the Red Hat build of Quarkus (Quarkus REST, ArC, Hibernate ORM, Narayana, Hibernate Validator).
  </description>

  <dependencies>
    <!--
      The developer names capabilities, not Quarkus extensions (design note 2.3): each bdi-* starter is an
      opinionated, RHBQ-supported dependency set plus the bdi-config-* module that configures it. The JPA
      starter is the one variation the team picks, according to the database of the application.
    -->
    <dependency>
      <groupId>it.bancaditalia.quarkus</groupId>
      <artifactId>bdi-rest-jackson</artifactId>       <!-- JAX-RS, Jackson, Bean Validation, OpenAPI -->
    </dependency>
    <dependency>
      <groupId>it.bancaditalia.quarkus</groupId>
      <artifactId>bdi-jpa-postgresql</artifactId>     <!-- JPA, JTA, PostgreSQL driver; or bdi-jpa-oracle / bdi-jpa-db2 -->
    </dependency>
    <dependency>
      <groupId>it.bancaditalia.quarkus</groupId>
      <artifactId>bdi-observability</artifactId>      <!-- health, JSON logs, conformance endpoint, config contract -->
    </dependency>
    <dependency>
      <groupId>it.bancaditalia.quarkus</groupId>
      <artifactId>bdi-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
