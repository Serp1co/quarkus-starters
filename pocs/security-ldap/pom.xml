<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <!-- The application parent: contract export, lint, governance and packaging come from it, nothing is declared here -->
    <groupId>it.bancaditalia.quarkus</groupId>
    <artifactId>bdi-quarkus-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../bdi-quarkus/parent/pom.xml</relativePath>
  </parent>

  <artifactId>poc-security-ldap</artifactId>
  <name>POC security: Active Directory / LDAP</name>
  <description>
    Inbound identity from Active Directory (design note 4.5, the legacy bridge): an EAP application whose
    security domain was the corporate AD keeps HTTP Basic, @RolesAllowed and its group-based roles on the Red
    Hat build of Quarkus. The AD groups to application roles mapping is a platform key per environment; the
    audit trail is a JSON log line per authentication and authorization outcome.
  </description>

  <dependencies>
    <dependency>
      <groupId>it.bancaditalia.quarkus</groupId>
      <artifactId>bdi-rest-jackson</artifactId>       <!-- JAX-RS, Jackson, Bean Validation, OpenAPI -->
    </dependency>
    <dependency>
      <groupId>it.bancaditalia.quarkus</groupId>
      <artifactId>bdi-security-ldap</artifactId>      <!-- the variation: Elytron LDAP realm shaped for AD, Basic auth -->
    </dependency>
    <dependency>
      <groupId>it.bancaditalia.quarkus</groupId>
      <artifactId>bdi-observability</artifactId>      <!-- health, JSON logs, conformance endpoint, config contract -->
    </dependency>
    <dependency>
      <groupId>it.bancaditalia.quarkus</groupId>
      <artifactId>bdi-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>it.bancaditalia.quarkus</groupId>
      <artifactId>bdi-test-ldap</artifactId>          <!-- the AD look-alike the tests authenticate against -->
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
