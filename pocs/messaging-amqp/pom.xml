<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <!-- The application parent: contract export, lint, governance and packaging come from it, nothing is declared here -->
    <groupId>it.bancaditalia.quarkus</groupId>
    <artifactId>bdi-quarkus-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../bdi-quarkus/parent/pom.xml</relativePath>
  </parent>

  <artifactId>poc-messaging-amqp</artifactId>
  <name>POC messaging: AMQP</name>
  <description>
    Queues and topics (design note 4.3): MDB + JPA in one XA transaction on EAP versus Reactive Messaging over AMQP 1.0
    with a transactional outbox, an idempotent consumer and broker redelivery to the DLQ; plus the JMS API variation
    (Qpid JMS, transacted sessions and selectors) on the same broker and the same platform keys.
  </description>

  <dependencies>
    <dependency>
      <groupId>it.bancaditalia.quarkus</groupId>
      <artifactId>bdi-rest-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>it.bancaditalia.quarkus</groupId>
      <artifactId>bdi-jpa-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>it.bancaditalia.quarkus</groupId>
      <artifactId>bdi-messaging-amqp</artifactId>     <!-- Reactive Messaging over AMQP 1.0: the MDB replacement -->
    </dependency>
    <dependency>
      <groupId>it.bancaditalia.quarkus</groupId>
      <artifactId>bdi-jms-amqp</artifactId>           <!-- the JMS API variation (amqphub, not in the RHBQ platform) -->
    </dependency>
    <dependency>
      <groupId>it.bancaditalia.quarkus</groupId>
      <artifactId>bdi-scheduler-local</artifactId>    <!-- the outbox relay, per instance, SKIP LOCKED -->
    </dependency>
    <dependency>
      <groupId>it.bancaditalia.quarkus</groupId>
      <artifactId>bdi-observability</artifactId>
    </dependency>
    <dependency>
      <groupId>it.bancaditalia.quarkus</groupId>
      <artifactId>bdi-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
