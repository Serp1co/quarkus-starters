<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <!-- The application parent: contract export, lint, governance and packaging come from it, nothing is declared here -->
    <groupId>it.bancaditalia.quarkus</groupId>
    <artifactId>bdi-quarkus-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../bdi-quarkus/parent/pom.xml</relativePath>
  </parent>

  <artifactId>poc-messaging-kafka</artifactId>
  <name>POC messaging: Kafka</name>
  <description>
    Kafka (design note 4.4): produce and consume with Reactive Messaging, the same channel abstraction as AMQP with
    different semantics: keys and ordering per partition, consumer groups, throttled commits, a dead-letter topic
    for poison records, an idempotent consumer. Streams and the schema registry are called out, not built.
  </description>

  <dependencies>
    <dependency>
      <groupId>it.bancaditalia.quarkus</groupId>
      <artifactId>bdi-rest-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>it.bancaditalia.quarkus</groupId>
      <artifactId>bdi-jpa-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>it.bancaditalia.quarkus</groupId>
      <artifactId>bdi-messaging-kafka</artifactId>
    </dependency>
    <dependency>
      <groupId>it.bancaditalia.quarkus</groupId>
      <artifactId>bdi-observability</artifactId>
    </dependency>
    <dependency>
      <groupId>it.bancaditalia.quarkus</groupId>
      <artifactId>bdi-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
