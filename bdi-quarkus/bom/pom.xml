<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>it.bancaditalia.quarkus</groupId>
    <artifactId>quarkus-starters</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>bdi-quarkus-bom</artifactId>
  <packaging>pom</packaging>
  <name>bdi-quarkus-bom</name>
  <description>
    The internal BOM (design note 2.3) for applications that do not inherit the repository parent: one
    import gives the RHBQ platform stream plus every bdi-* starter and config module at the same version.
  </description>

  <!--
    Usage in an application POM:
      <dependencyManagement><dependencies><dependency>
        <groupId>it.bancaditalia.quarkus</groupId><artifactId>bdi-quarkus-bom</artifactId>
        <version>...</version><type>pom</type><scope>import</scope>
      </dependency></dependencies></dependencyManagement>
  -->

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>${quarkus.platform.artifact-id}</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>it.bancaditalia.quarkus</groupId>
        <artifactId>platform-contract</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>it.bancaditalia.quarkus</groupId>
        <artifactId>bdi-config-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>it.bancaditalia.quarkus</groupId>
        <artifactId>bdi-config-rest</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>it.bancaditalia.quarkus</groupId>
        <artifactId>bdi-config-jpa</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>it.bancaditalia.quarkus</groupId>
        <artifactId>bdi-config-observability</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>it.bancaditalia.quarkus</groupId>
        <artifactId>bdi-rest-jackson</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>it.bancaditalia.quarkus</groupId>
        <artifactId>bdi-jpa-postgresql</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>it.bancaditalia.quarkus</groupId>
        <artifactId>bdi-jpa-oracle</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>it.bancaditalia.quarkus</groupId>
        <artifactId>bdi-jpa-db2</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>it.bancaditalia.quarkus</groupId>
        <artifactId>bdi-observability</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>it.bancaditalia.quarkus</groupId>
        <artifactId>bdi-config-scheduler</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>it.bancaditalia.quarkus</groupId>
        <artifactId>bdi-config-flyway</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>it.bancaditalia.quarkus</groupId>
        <artifactId>bdi-scheduler</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>it.bancaditalia.quarkus</groupId>
        <artifactId>bdi-flyway-postgresql</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>it.bancaditalia.quarkus</groupId>
        <artifactId>bdi-test</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
