  <artifactId>bdi-scheduler-local</artifactId>
  <name>Starter: bdi-scheduler-local</name>
  <description>In-memory @Scheduled (quarkus-scheduler), per instance and not clustered: for housekeeping that every instance may run on its own (outbox relay with SKIP LOCKED, cache refresh). Timers that must run once across the cluster take bdi-scheduler.</description>

  <dependencies>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-scheduler</artifactId>
    </dependency>
  </dependencies>
</project>
