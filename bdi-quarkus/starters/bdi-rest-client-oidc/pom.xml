  <artifactId>bdi-rest-client-oidc</artifactId>
  <name>Starter: bdi-rest-client-oidc</name>
  <description>Identity on outbound REST calls: the caller's bearer token propagated (@AccessToken, the user acts through the application) or the application's own token from its RHBK client (@OidcClientFilter, client credentials), configured by bdi-config-oidc-client. Builds on bdi-rest-client.</description>

  <dependencies>
    <dependency>
      <groupId>it.bancaditalia.quarkus</groupId>
      <artifactId>bdi-rest-client</artifactId>
    </dependency>    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-client-oidc-token-propagation</artifactId>
    </dependency>    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-client-oidc-filter</artifactId>
    </dependency>    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-oidc-client</artifactId>
    </dependency>    <dependency>
      <groupId>it.bancaditalia.quarkus</groupId>
      <artifactId>bdi-config-oidc-client</artifactId>
    </dependency>  </dependencies>
</project>
