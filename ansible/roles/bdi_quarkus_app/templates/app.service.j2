# {{ ansible_managed }}
# Hardened unit for a Quarkus fast-jar. Provisioned by the platform role; application repositories never
# contain a unit file (design note 3). The application is configured only through the two variables below.
[Unit]
Description=BdI Quarkus application {{ bdi_app }} ({{ bdi_env }})
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ bdi_service_user }}
Group={{ bdi_service_group }}
WorkingDirectory={{ bdi_root }}/{{ bdi_app }}/current
# The three variables live in {{ bdi_etc }}/{{ bdi_app }}/environment, quoted: an Environment= line splits on spaces.
EnvironmentFile={{ bdi_etc }}/{{ bdi_app }}/environment
ExecStart={{ bdi_java }} $JAVA_OPTS -jar {{ bdi_root }}/{{ bdi_app }}/current/quarkus-app/quarkus-run.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ bdi_root }}/{{ bdi_app }} {{ bdi_var }}/{{ bdi_app }}
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
