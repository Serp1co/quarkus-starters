<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>it.bancaditalia.quarkus</groupId>
  <artifactId>quarkus-starters</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Quarkus Starters</name>
  <description>
    Container repository for the Banca d'Italia Quarkus POC and cookbook programme.
    This POM plays the role of the internal parent POM (design note 2.3): it pins every module to one
    Red Hat build of Quarkus (RHBQ) platform stream and centralises the build conventions.
  </description>

  <modules>
    <module>concepts/platform-contract</module>
    <module>bdi-quarkus</module>
    <module>pocs/a-jakarta-classic</module>
  </modules>

  <properties>
    <!--
      RHBQ platform stream: the single place where the Quarkus version is chosen.
      Value published by code.quarkus.redhat.com for stream 3.33 (LTS), checked on 2026-09-17.
    -->
    <quarkus.platform.group-id>com.redhat.quarkus.platform</quarkus.platform.group-id>
    <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
    <quarkus.platform.version>3.33.1.redhat-00006</quarkus.platform.version>
    <!-- Upstream release the RHBQ build is based on. Used only by the 'community' escape hatch below. -->
    <quarkus.upstream.version>3.33.1</quarkus.upstream.version>

    <!-- JDK baseline: Red Hat build of OpenJDK 21. RHBQ 3.33 supports OpenJDK 17, 21 and 25. -->
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <compiler-plugin.version>3.14.1</compiler-plugin.version>
    <surefire-plugin.version>3.5.6</surefire-plugin.version>
    <enforcer-plugin.version>3.6.3</enforcer-plugin.version>
    <jandex-plugin.version>3.6.0</jandex-plugin.version>
    <!-- Integration tests (@QuarkusIntegrationTest against the packaged artifact) are opt-in: -DskipITs=false -->
    <skipITs>true</skipITs>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>${quarkus.platform.artifact-id}</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!--
        Artifacts of this repository. Applications outside the reactor import bdi-quarkus/bom instead,
        which manages the same list on top of the platform BOM.
      -->
      <dependency>
        <groupId>it.bancaditalia.quarkus</groupId>
        <artifactId>platform-contract</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>it.bancaditalia.quarkus</groupId>
        <artifactId>bdi-config-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>it.bancaditalia.quarkus</groupId>
        <artifactId>bdi-config-rest</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>it.bancaditalia.quarkus</groupId>
        <artifactId>bdi-config-jpa</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>it.bancaditalia.quarkus</groupId>
        <artifactId>bdi-config-observability</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>it.bancaditalia.quarkus</groupId>
        <artifactId>bdi-rest-jackson</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>it.bancaditalia.quarkus</groupId>
        <artifactId>bdi-jpa-postgresql</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>it.bancaditalia.quarkus</groupId>
        <artifactId>bdi-jpa-oracle</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>it.bancaditalia.quarkus</groupId>
        <artifactId>bdi-jpa-db2</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>it.bancaditalia.quarkus</groupId>
        <artifactId>bdi-observability</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>it.bancaditalia.quarkus</groupId>
        <artifactId>bdi-test</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>${quarkus.platform.group-id}</groupId>
          <artifactId>quarkus-maven-plugin</artifactId>
          <version>${quarkus.platform.version}</version>
          <extensions>true</extensions>
          <executions>
            <execution>
              <goals>
                <goal>build</goal>
                <goal>generate-code</goal>
                <goal>generate-code-tests</goal>
                <goal>native-image-agent</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <!-- Libraries that contribute CDI beans to an application need a Jandex index -->
          <groupId>io.smallrye</groupId>
          <artifactId>jandex-maven-plugin</artifactId>
          <version>${jandex-plugin.version}</version>
          <executions>
            <execution>
              <id>make-index</id>
              <goals>
                <goal>jandex</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${compiler-plugin.version}</version>
          <configuration>
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire-plugin.version}</version>
          <configuration>
            <systemPropertyVariables>
              <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
              <maven.home>${maven.home}</maven.home>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${surefire-plugin.version}</version>
          <executions>
            <execution>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
          <configuration>
            <systemPropertyVariables>
              <native.image.path>${project.build.directory}/${project.build.finalName}-runner</native.image.path>
              <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
              <maven.home>${maven.home}</maven.home>
            </systemPropertyVariables>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-toolchain</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[3.9.9,)</version>
                </requireMavenVersion>
                <requireJavaVersion>
                  <version>[17,26)</version>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Default: RHBQ artifacts come from the Red Hat GA repository (they are not on Maven Central).
      In the bank this repository is mirrored by Nexus/Artifactory; a settings.xml mirror overrides the URL.
    -->
    <profile>
      <id>rhbq</id>
      <activation>
        <property>
          <name>!community</name>
        </property>
      </activation>
      <repositories>
        <repository>
          <id>redhat</id>
          <name>Red Hat GA repository</name>
          <url>https://maven.repository.redhat.com/ga</url>
          <releases>
            <enabled>true</enabled>
          </releases>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>redhat</id>
          <name>Red Hat GA repository</name>
          <url>https://maven.repository.redhat.com/ga</url>
          <releases>
            <enabled>true</enabled>
          </releases>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>

    <!--
      Escape hatch: build against the upstream community platform the RHBQ stream is based on, for
      environments that cannot reach maven.repository.redhat.com. Never for a deliverable: the support
      contract covers RHBQ bits only.
          ./mvnw verify -Dcommunity=true
    -->
    <profile>
      <id>community</id>
      <activation>
        <property>
          <name>community</name>
        </property>
      </activation>
      <properties>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.version>${quarkus.upstream.version}</quarkus.platform.version>
      </properties>
    </profile>

    <!-- Native is not a target of this programme (design note: native only with a measured reason). Kept for experiments. -->
    <profile>
      <id>native</id>
      <activation>
        <property>
          <name>native</name>
        </property>
      </activation>
      <properties>
        <skipITs>false</skipITs>
        <quarkus.native.enabled>true</quarkus.native.enabled>
      </properties>
    </profile>
  </profiles>
</project>
